{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "test:integration": "firebase emulators:exec --only functions,firestore --project demo-sage \"node functions/test/integration/syncGarden.emulator.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
