rules_version = '2';

// The Android app never talks to Firestore directly — only Cloud Functions
// (using the Admin SDK, which bypasses these rules) read/write this database.
// Deny all direct client access by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
