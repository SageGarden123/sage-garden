rules_version = '2';

// The Android app never reads or writes garden data directly — only Cloud Functions (using the
// Admin SDK, which bypasses these rules) read/write this database. Deny all direct client access
// by default.
//
// Single exception: gardenSignals/{gardenId} — a tiny "this garden changed" doc (no plant data)
// that the Android app listens to instead of polling syncGarden every minute. Readable only by a
// Firebase (anonymous) Auth uid that syncGarden has recorded under readers/, which it does only
// after that device's normal memberToken check passes. See functions/src/gardenSignals.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /gardenSignals/{gardenId} {
      allow get: if request.auth != null
        && exists(/databases/$(database)/documents/gardenSignals/$(gardenId)/readers/$(request.auth.uid));
    }
  }
}
