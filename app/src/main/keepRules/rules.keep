# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Glance app widgets translate Compose-like code into RemoteViews at runtime via reflection/
# internal state-persistence machinery that isn't fully covered by Glance's own default R8 rules
# in this version — after enabling R8, the widget showed "can't load widget" in the picker and got
# stuck on its loading layout forever. Keep Glance and this app's own widget classes whole.
-keep class androidx.glance.** { *; }
-keep interface androidx.glance.** { *; }
-dontwarn androidx.glance.**

-keep class com.example.sagegarden.WateringWidget { *; }
-keep class com.example.sagegarden.WateringWidgetReceiver { *; }
-keep class com.example.sagegarden.WateringWidgetRefreshReceiver { *; }
-keep class com.example.sagegarden.WateringWidgetRefreshWorker { *; }
-keep class com.example.sagegarden.WateringWidgetConfigActivity { *; }

# Same category of issue as Glance above, different library: the real-world map (Google Maps
# Compose wrapper over the Play Services Maps SDK) renders via a separate process, communicating
# over Parcelable/AIDL — R8 renaming a class or stripping a CREATOR field involved in that breaks
# it silently (blank map, no crash), independent of API key/permission correctness.
-keep class com.google.android.gms.maps.** { *; }
-keep interface com.google.android.gms.maps.** { *; }
-keep class com.google.maps.android.** { *; }
-keep interface com.google.maps.android.** { *; }
-dontwarn com.google.android.gms.maps.**
-dontwarn com.google.maps.android.**
-keepclassmembers class * implements android.os.Parcelable {
    public static final ** CREATOR;
}