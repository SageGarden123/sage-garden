<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- OAuth tokens and API secrets (Dropbox, Tuya, and future integrations) live here — never
             include them in cloud backup. Everything else (plant data, ordinary settings) is fine. -->
        <exclude domain="sharedpref" path="garden_mapper_credential_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="garden_mapper_credential_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>