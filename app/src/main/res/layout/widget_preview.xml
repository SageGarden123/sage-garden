<?xml version="1.0" encoding="utf-8"?>
<!-- Static mockup shown in the OS widget picker before placement — never actually rendered live,
     just a believable preview of the widget's real (Glance-rendered) content. Keep it in sync by
     eye with WateringWidgetContent/WateringWidgetRow in WateringWidget.kt if that layout changes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F0"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌿 Care due"
        android:textColor="#233821"
        android:textStyle="bold"
        android:textSize="14sp" />

    <Space android:layout_width="0dp" android:layout_height="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_preview_icon_bg"
            android:gravity="center"
            android:text="🌿"
            android:textSize="15sp" />
        <Space android:layout_width="8dp" android:layout_height="0dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fiddle-leaf fig"
                android:textColor="#233821"
                android:textSize="13sp"
                android:textStyle="normal" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Water: Overdue by 2 day(s)"
                android:textColor="#B23B3B"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_preview_icon_bg"
            android:gravity="center"
            android:text="✂️"
            android:textSize="15sp" />
        <Space android:layout_width="8dp" android:layout_height="0dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rosemary"
                android:textColor="#233821"
                android:textSize="13sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prune: Due today"
                android:textColor="#808080"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
